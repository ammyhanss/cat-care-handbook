---
import { copyFor, guideOrder } from '../i18n/ui';

const copy = copyFor(Astro.locals.starlightRoute.lang);
const locale = Astro.locals.starlightRoute.locale;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const prefix = locale ? `${locale}/` : '';
---

<section class="guide-section" aria-labelledby="guide-title">
  <h2 id="guide-title">{copy.guideTitle}</h2>
  <p>{copy.guideLead}</p>
  <ul class="system-list">
    {
      guideOrder.map((key) => (
        <li>
          <a href={`${base}${prefix}guide/${key}/`}>{copy.guidePages[key]}</a>
        </li>
      ))
    }
  </ul>
</section>
